{
  "info": {
    "_postman_id": "oficioya-e2e-collection-sprint4",
    "name": "OficioYa Backend - Suite E2E Automatizada (Sprint 4)",
    "description": "Colección completa de pruebas E2E automatizadas para la plataforma OficioYa (DOSW - Sprint 4). Incluye pruebas de salud, catálogo, búsqueda meritocrática, autenticación real con JWT, ciclo completo de negocio y pruebas negativas de seguridad 401 y 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Salud & Documentación",
      "item": [
        {
          "name": "01. Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Servicio activo con status UP', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.service).to.eql('OficioYa-Backend');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02. Contrato OpenAPI 3 (v3/api-docs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["v3", "api-docs"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('OpenAPI v3 esquema válido', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.openapi).to.exist;",
                  "    pm.expect(json.info.title).to.include('OficioYa');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Endpoints Públicos (Sin Autenticación)",
      "item": [
        {
