# Puerto de la Aplicación
SERVER_PORT=8082

# Base de Datos Relacional (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/oficioyadb
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# Base de Datos Documental (MongoDB)
SPRING_DATA_MONGODB_URI=mongodb://root:rootpassword@localhost:27017/oficioyadb_nosql?authSource=admin

# Seguridad y Autenticación JWT
APPLICATION_SECURITY_JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APPLICATION_SECURITY_JWT_EXPIRATION=86400000

# Entorno de Ejecución (dev, qa, prod)
SPRING_PROFILES_ACTIVE=dev
